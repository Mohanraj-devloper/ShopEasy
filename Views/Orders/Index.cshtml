@model List<ShopEasy.Models.Order>

<h2>All Orders</h2>

<table class="table">
    <tr><th>Order #</th><th>Customer</th><th>Phone</th><th>Date</th><th>Total</th><th></th></tr>
    @foreach (var o in Model)
    {
        <tr>
            <td>@o.Id</td>
            <td>@o.CustomerName</td>
            <td>@o.Phone</td>
            <td>@o.OrderDate.ToString("dd-MM-yyyy hh:mm tt")</td>
            <td>₹@o.TotalAmount</td>
            <td><a asp-action="Details" asp-route-id="@o.Id" class="btn btn-sm btn-info">Details</a></td>
        </tr>
    }
</table>